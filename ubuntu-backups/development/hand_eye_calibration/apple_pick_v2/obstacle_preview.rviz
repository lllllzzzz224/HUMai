Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: moveit_rviz_plugin/PlanningScene
      Name: Recorded scene - execution disabled
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Scene Geometry:
        Scene Alpha: 0.75
      Scene Robot:
        Robot Alpha: 0.5
        Show Robot Visual: true
        Show Robot Collision: true
      Value: true
    - Class: moveit_rviz_plugin/Trajectory
      Name: Preview trajectory - not executable
      Robot Description: robot_description
      Trajectory Topic: /display_planned_path
      Loop Animation: true
      State Display Time: 0.05 s
      Show Robot Visual: true
      Show Robot Collision: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Observed points - hidden space unknown
      Topic:
        Value: /offline_preview/observed_points
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 80; 180; 220
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Recorded capture timestamp - not live
      Topic:
        Value: /offline_preview/status
        Durability Policy: Transient Local
      Value: true
  Global Options:
    Fixed Frame: base_link
    Background Color: 35; 40; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.7
      Focal Point: {X: 0.25, Y: -0.15, Z: 0.2}
      Pitch: 0.65
      Yaw: -0.6
Window Geometry:
  Height: 900
  Width: 1350
